{
  "name": "aurora",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "Aurora",
  "author": "Vasil Sokolov <vasil@afterlogic.com>",
  "private": true,
  "scripts": {
    "lint": "eslint --ext .js,.vue ./",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "node e2e/scripts/run-with-email-report.js",
    "test:e2e_local": "playwright test",
    "test:e2e_local:iphone": "playwright test --project=\"iPhone 13\"",
    "test:e2e_local:webkit": "playwright test --project=\"iPhone SE WebKit\" --project=\"iPhone 13 WebKit\"",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install-browsers": "playwright install chromium webkit",
    "dev": "quasar dev",
    "build": "quasar build",
    "prepare-langs": "node build-scripts/prepare-langs.js",
    "prepare-files": "node build-scripts/prepare-files.js",
    "build-production": "node build-scripts/build-production.js"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "axios": "^1.2.1",
    "core-js": "^3.6.5",
    "device-uuid": "^1.0.4",
    "file-saver": "^2.0.5",
    "iniparser": "^1.0.5",
    "moment": "^2.30.1",
    "openpgp": "4.5",
    "pinia": "^2.0.11",
    "quasar": "^2.6.0",
    "querystring": "^0.2.1",
    "tiny-emitter": "^2.1.0",
    "vue": "^3.0.0",
    "vue-cookies": "^1.8.3",
    "vue-i18n": "^9.0.0",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.13.14",
    "@playwright/test": "^1.49.0",
    "@quasar/app-webpack": "^3.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@vue/compiler-dom": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^8.10.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-vue": "^9.0.0",
    "eslint-webpack-plugin": "^3.1.1",
    "jsdom": "^29.1.1",
    "prettier": "^2.5.1",
    "sass": "^1.101.3",
    "vite": "^6",
    "vitest": "^4.1.10"
  },
  "browserslist": [
    "last 10 Chrome versions",
    "last 10 Firefox versions",
    "last 4 Edge versions",
    "last 7 Safari versions",
    "last 8 Android versions",
    "last 8 ChromeAndroid versions",
    "last 8 FirefoxAndroid versions",
    "last 10 iOS versions",
    "last 5 Opera versions"
  ],
  "engines": {
    "node": ">= 12.22.1",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
