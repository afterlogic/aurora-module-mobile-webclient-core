# Copy to .env.e2e and fill in real values (`.env.e2e` is gitignored):
#   cp .env.e2e.example .env.e2e
#
# Default URL matches setup-local.sh:
PLAYWRIGHT_BASE_URL=http://localhost:8888/?mobile-version
E2E_LOGIN=your-test-user@example.com
E2E_PASSWORD=test
# Optional: recipient for compose test (defaults to E2E_LOGIN)
# E2E_COMPOSE_TO=your-test-user@example.com

# Mail sending config
MAIL_HOST=MAIL_SERVER_ADDRESS
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=mail-account-login
MAIL_PASSWORD=mail-account-password
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=E2E Bot
E2E_MAIL_TO=comma-separated-recipient-list
E2E_MAIL_SUBJECT=Playwright E2E report
WEB_INSTALL_URL=
